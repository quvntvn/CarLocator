    <string name="battery_optimization_warning">Détection en arrière-plan à risque ! Appuyez ici pour désactiver l\'optimisation batterie.</string>
    <string name="garage_add_info">Ajouter votre voiture ouvre une fenêtre système. Acceptez la demande d\'appairage Bluetooth si elle apparaît.</string>

