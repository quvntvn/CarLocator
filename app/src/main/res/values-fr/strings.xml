    <string name="xiaomi_warning_title">Xiaomi / MIUI détecté</string>
    <string name="xiaomi_warning_body">Pour que l\'app détecte votre voiture en arrière-plan, vous devez activer manuellement l\'Autostart et lever les restrictions batterie. Appuyez pour ouvrir les réglages.</string>
    <string name="xiaomi_warning_action">Ouvrir les réglages Autostart</string>
    <string name="xiaomi_warning_done">C\'est configuré</string>
    <string name="xiaomi_warning_steps_title">Étapes obligatoires</string>
    <string name="xiaomi_warning_steps_body">1. Activez « Autostart » pour Car Locator\n2. Économie batterie : choisir « Aucune restriction »\n3. Dans les apps récentes, verrouillez l\'app (icône cadenas 🔒)\n\nSans ces étapes, MIUI/HyperOS tuera l\'app et bloquera la détection Bluetooth.</string>
    <string name="xiaomi_autostart_denied_title">Autostart désactivé — correction requise</string>
    <string name="xiaomi_autostart_denied_body">MIUI/HyperOS empêche Car Locator de démarrer en arrière-plan. Appuyez pour corriger.</string>
